(data_only_dirs cimgui)

(rule
 (deps
  (source_tree cimgui))
 (targets libcimgui.a dllcimgui.so)
 (enabled_if
  (<> %{ocaml-config:system} macosx))
 (alias cimgui)
 (action
  (no-infer
   (progn
    (chdir
     cimgui
     (progn
      (run mkdir -p build)))
    (chdir
     cimgui/build
     (progn
      (run cmake -DCMAKE_BUILD_TYPE=RelWithDebInfo -DIMGUI_FREETYPE=yes -DIMGUI_STATIC=both ..)
      (run make)))
    (copy cimgui/build/cimgui.so dllcimgui.so)
    (copy cimgui/build/cimgui.a libcimgui.a)))))

(rule
 (deps
  (source_tree cimgui))
 (targets libcimgui.a dllcimgui.so)
 (enabled_if
  (= %{ocaml-config:system} macosx))
 (alias cimgui)
 (action
  (no-infer
   (progn
    (chdir
     cimgui
     (progn
      (run mkdir -p build)))
    (chdir
     cimgui/build
     (progn
      (run cmake -DCMAKE_BUILD_TYPE=RelWithDebInfo -DIMGUI_FREETYPE=yes -DIMGUI_STATIC=both ..)
      (run make)))
    (copy cimgui/build/cimgui.dylib dllcimgui.so)
    (copy cimgui/build/cimgui.a libcimgui.a)))))

(library
 (name cimgui)
 (public_name imguiml.cimgui)
 (c_library_flags -lfreetype -lstdc++)
 (public_headers
  cimgui/cimgui.h
  (glob_files cimgui/imgui/*.h))
 (foreign_archives cimgui))
